package tests;

use ecosystem::bitflags;
use bitflags::Flags;
use std::testing;

#[derive(Flags, bitflags::FlagValues)]
#[flags(BASE = "0x8000000000000000", A0 = "BASE | BASE", A1 = "A0 | A0", A2 = "A1 | A1", A3 = "A2 | A2", A4 = "A3 | A3", A5 = "A4 | A4", A6 = "A5 | A5", A7 = "A6 | A6", A8 = "A7 | A7", A9 = "A8 | A8", A10 = "A9 | A9", A11 = "A10 | A10", A12 = "A11 | A11", A13 = "A12 | A12", A14 = "A13 | A13", A15 = "A14 | A14", A16 = "A15 | A15", A17 = "A16 | A16", A18 = "A17 | A17", A19 = "A18 | A18", A20 = "A19 | A19", A21 = "A20 | A20", A22 = "A21 | A21", A23 = "A22 | A22", LOW = "0b1", BOTH = "A23 | LOW")]
struct CachedMasks {
    bits: i64,
}

#[test]
fn repeated_alias_references_preserve_masks_without_recursive_expansion() -> () {
    testing::assert_eq(CachedMasks::flag_a23().bits(), 0x8000000000000000);
    testing::assert_eq(CachedMasks::flag_both().bits(), 0x8000000000000001);
    testing::assert_eq(CachedMasks::all().bits(), 0x8000000000000001);
    testing::assert_eq(CachedMasks::empty().definitions().len(), 27);
    let named = testing::expect_some(CachedMasks::from_name("A12"), "alias");
    testing::assert_eq(named.bits(), CachedMasks::flag_base().bits());
}
